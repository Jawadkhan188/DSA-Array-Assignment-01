import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int[] a = new int[10];

        System.out.println("Enter 10 numbers:");

        for (int i = 0; i < 10; i++) {
            a[i] = sc.nextInt();
        }

        for (int i = 0; i < 10; i++) {
            int count = 0;
            boolean printed = false;

            for (int j = 0; j < i; j++) {
                if (a[i] == a[j]) {
                    printed = true;
                    break;
                }
            }

            if (!printed) {
                for (int j = 0; j < 10; j++) {
                    if (a[i] == a[j]) {
                        count++;
                    }
                }

                if (count > 1) {
                    System.out.println(
                        a[i] + " occurs " + count + " times"
                    );
                }
            }
        }

        sc.close();
    }
}
